# =============================================
# Nova Store Backend — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# =============================================

PORT=3000

# Conexión a Oracle
DB_HOST=localhost
DB_PORT=1521
DB_USER=TU_USUARIO_ORACLE
DB_PASSWORD=TU_PASSWORD_ORACLE
DB_SERVICE=orclpdb
ORACLE_CONNECT_STRING=localhost:1521/orclpdb

# Pool de conexiones
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# JWT — usa un valor aleatorio seguro de mínimo 16 caracteres
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO
JWT_EXPIRES_IN=8h

# URL(s) del frontend permitidas por CORS. Varias separadas por coma.
# Ejemplo: http://localhost:5173,https://tudominio.com
FRONTEND_SERVICE=http://localhost:5173
